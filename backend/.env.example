DRMS_DB_HOST=127.0.0.1
DRMS_DB_PORT=3306
DRMS_DB_NAME=dental_clinic
DRMS_DB_USER=dental_app
DRMS_DB_PASSWORD=replace-with-a-strong-database-password

# Generate a private value before deployment. Do not commit the real key.
DRMS_DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Generate once with Fernet.generate_key(); keep this separate from the Django key.
# Required when DRMS_DEBUG=0. Never expose it to the browser or change it casually.

# Development settings. Set DEBUG to 0 before deployment.
DRMS_DEBUG=1
DRMS_ALLOWED_HOSTS=127.0.0.1,localhost

# Add the frontend's LAN origin (for example http://192.168.1.10:5173) when
# testing from another device; it is checked for both CSRF and WebSockets.
DRMS_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required on the Railway ASGI web service for cross-process dashboard updates.
# The single-process local development server works without Redis.
# REDIS_URL=redis://127.0.0.1:6379/0

# Use 1 only when the site is served over HTTPS.
DRMS_COOKIE_SECURE=0

# Optional real SMS. Keep disabled until the chosen provider is configured.
SMS_ENABLED=0
SMS_CLINIC_NAME=BORJA Dental Clinic
SMS_PROVIDER=semaphore
# For temporary PHILSMS delivery, set SMS_PROVIDER=philsms and configure both
# values below on the Django web service and the always-on SMS worker.
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=
# Semaphore remains available when SMS_PROVIDER=semaphore.
SEMAPHORE_API_KEY=
# Use your approved sender name, or leave blank for the account default.
SEMAPHORE_SENDER_NAME=

# Abstract Email Reputation API (backend only; never add this to Vite variables).
ABSTRACT_EMAIL_REPUTATION_API_KEY=

# Password recovery email (configure a verified Resend sender domain in Railway).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
RESEND_FROM_NAME=BORJA Dental Clinic
